{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "author": "luulichma <luulichma@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,json,ts}\"",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "playwright test --config playwright.benchmark.config.ts",
    "typecheck": "tsc -b --pretty false",
    "generate:api": "openapi-typescript ../contracts/openapi/PromptVideo.Api.json -o src/generated/api/schema.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "dexie": "^4.4.6",
    "mediabunny": "^1.57.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
