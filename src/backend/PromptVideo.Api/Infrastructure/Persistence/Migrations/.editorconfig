# EF Core scaffolds everything in this folder. It is generated code, so it is not
# held to the project's style and performance analyzers; hand-editing a migration
# to satisfy a rule would be undone by the next `dotnet ef migrations add`.
[*.cs]
generated_code = true
dotnet_analyzer_diagnostic.category-Performance.severity = none
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_analyzer_diagnostic.category-Maintainability.severity = none
dotnet_analyzer_diagnostic.category-Naming.severity = none
